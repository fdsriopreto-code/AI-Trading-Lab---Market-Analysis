NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# In EasyPanel use the internal PostgreSQL hostname/service name and internal port.
DATABASE_URL=postgresql://app_user:replace_me@postgres:5432/ai_trading_lab
PGSSL=false
FRONTEND_ORIGIN=https://your-frontend.example.com
# Optional. Keep this private; only the API server may call n8n.
N8N_ANALYZE_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
