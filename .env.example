# EasyPanel reads this file to offer Compose interpolation variables.
# Use a long random alphanumeric password (URL-safe) for POSTGRES_PASSWORD.
POSTGRES_DB=ai_trading_lab
POSTGRES_USER=ai_trading_lab
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_SECRET

# Optional: exact public frontend origin, e.g. https://trading.example.com
FRONTEND_ORIGIN=

# Set after importing/activating the workflow in n8n. Never commit real values.
N8N_ANALYZE_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Paper trading only. No exchange order credentials are used by the simulator.
PAPER_INITIAL_BALANCE=1000
PAPER_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
PAPER_MAX_TRADE_PCT=0.10
PAPER_MAX_EXPOSURE_PCT=0.70
PAPER_MAX_OPEN_TRADES=5
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_RATE=0.0005
PAPER_MAX_DRAWDOWN_PCT=0.15
PAPER_OUTCOME_HORIZON_CANDLES=12
PAPER_AUTO_ANALYZE=false
PAPER_AUTO_TIMEFRAME=5m
PAPER_AUTO_INTERVAL_MINUTES=5
